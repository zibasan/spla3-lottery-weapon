{
  "name": "spla3-lottery-weapon",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "bun biome lint ./src",
    "lint@fix": "bun biome lint ./src --write",
    "format": "bun biome format ./src --write",
    "check": "bun biome check ./src",
    "check@fix": "bun biome check ./src --write",
    "preview": "vite preview",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "tsc -b && vite build && electron-builder"
  },
  "build": {
    "appId": "com.zibasan.weaponlottery",
    "productName": "ブキみくじ",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon.ico"
    },
    "mac": {
      "icon": "public/icon.icns"
    },
    "linux": {
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.13.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.14",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  }
}