{
  "name": "spla3-lottery-weapon",
  "private": true,
  "description": "スプラトゥーン3のブキをランダムに抽選するアプリ / An app that randomly selects weapons for Splatoon 3.",
  "version": "0.15.4",
  "type": "module",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "bun biome lint ./src",
    "lint@fix": "bun biome lint ./src --write",
    "format": "bun biome format ./src --write",
    "check": "bun biome check ./src",
    "check@fix": "bun biome check ./src --write",
    "preview": "vite preview",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "cross-env ELECTRON=true bun run build && electron-builder",
    "dist": "bun run electron:build",
    "dist:win": "bun run build && electron-builder --win --x64 --arm64",
    "dist:mac": "bun run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "bun run build && electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "com.zibasan.weaponlottery",
    "productName": "Weapon Loterry",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "zibasan",
      "repo": "spla3-lottery-weapon",
      "releaseType": "release"
    },
    "win": {
      "icon": "build/favicon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "build/welcome.txt",
      "shortcutName": "ブキみくじ - Weapon Loterry"
    },
    "mac": {
      "icon": "build/favicon.icns",
      "target": [
        {
          "target": "default",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/favicon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.13.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.14",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  }
}